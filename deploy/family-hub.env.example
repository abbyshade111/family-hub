# Written by an AI coding tool (Claude Code) on 2026-10-03. Review it before using it on a server.
#
# Settings for Family Hub on the home server. Copy to /etc/family-hub/env (owner root, group
# familyhub, mode 0640) and fill in the secret there, never here: this file is in the repository.

# Where the database lives: a permanent folder on the encrypted disk, readable only by familyhub.
FAMILY_HUB_DATA=/var/lib/family-hub

# Signs the anti-forgery tokens on forms. 64 random hex characters, made on the server with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# (docs/DEPLOY-TAILSCALE.md writes it straight into /etc/family-hub/env without printing it.)
FAMILY_HUB_SECRET_KEY=

# `tailscale serve` is the one proxy in front of the app, so the visitor's address is read from
# the X-Forwarded-For it adds. Leave it at 1 unless something else is put in front too.
FAMILY_HUB_TRUSTED_PROXIES=1

# The leaked-password check online (Have I Been Pwned). 1 = on; 0 = only the list kept in the app.
FAMILY_HUB_BREACH_CHECK=1

# Daily backups (deploy/familyhub-backup.timer): where they go, and how many to keep.
# Put this folder on a second disk if you can, also encrypted.
FAMILY_HUB_BACKUP_DIR=/var/backups/family-hub
FAMILY_HUB_BACKUP_KEEP=14

# Sign-in with Google, Apple or another provider stays off unless these are set; for a family
# reached only through Tailscale, leave them unset.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
