# Written by an AI coding tool (Claude Code) on 2026-10-03. Review it before installing it on a server.
#
# Family Hub under systemd, on Debian 13. Install as /etc/systemd/system/familyhub.service
# (see docs/DEPLOY-TAILSCALE.md). It listens on 127.0.0.1 only; `tailscale serve` is the one way in.

[Unit]
Description=Family Hub
Documentation=file:///opt/family-hub/docs/DEPLOY-TAILSCALE.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=familyhub
Group=familyhub
WorkingDirectory=/opt/family-hub
# FAMILY_HUB_DATA, FAMILY_HUB_SECRET_KEY, FAMILY_HUB_TRUSTED_PROXIES: see deploy/family-hub.env.example
EnvironmentFile=/etc/family-hub/env
ExecStart=/usr/bin/python3 /opt/family-hub/serve.py --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
UMask=0077

# Least privilege: the app can write only its data folder, and nothing else on the system.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/family-hub
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
# It needs outbound HTTPS (Have I Been Pwned) and to listen on localhost.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
